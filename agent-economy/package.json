{
  "name": "agent-economy-motion",
  "version": "1.0.0",
  "private": true,
  "description": "Agent Economy — motion design piece (Remotion, 1920x1080, ~69s)",
  "scripts": {
    "prestart": "node scripts/make-sfx.mjs",
    "start": "remotion studio src/index.ts",
    "sfx": "node scripts/make-sfx.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/make-sfx.mjs",
    "build": "remotion render src/index.ts AgentEconomy out/agent-economy.mp4 --codec h264 --crf 16",
    "prepreview": "node scripts/make-sfx.mjs",
    "preview": "remotion render src/index.ts AgentEconomy out/agent-economy-preview.mp4 --scale=0.5 --crf 24",
    "still": "remotion still src/index.ts AgentEconomy out/still.png --frame 0"
  },
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.524"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.1.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.6.3"
  }
}
