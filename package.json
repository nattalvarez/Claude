{
  "name": "sirec-motion",
  "version": "1.0.0",
  "private": true,
  "description": "SIREC — Motion Graphics 30s (Remotion)",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render SirecMotion out/sirec-motion.mp4 --ignore-certificate-errors",
    "preview": "remotion render SirecMotion out/sirec-motion-preview.mp4 --scale=0.5 --jpeg-quality=80 --ignore-certificate-errors",
    "still": "remotion still SirecMotion out/still.png --ignore-certificate-errors",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@remotion/cli": "4.0.524",
    "@remotion/google-fonts": "4.0.524",
    "@remotion/motion-blur": "4.0.524",
    "@remotion/three": "^4.0.524",
    "@types/three": "^0.186.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.524",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.6.3"
  }
}
