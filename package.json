{
  "name": "sirec-motion",
  "version": "1.0.0",
  "private": true,
  "description": "SIREC — Un ecosistema que evoluciona contigo (Remotion)",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render SirecEcosystem out/sirec-ecosystem.mp4 --ignore-certificate-errors",
    "preview": "remotion render SirecEcosystem out/sirec-ecosystem-preview.mp4 --scale=0.5 --jpeg-quality=80 --ignore-certificate-errors",
    "still": "remotion still SirecEcosystem out/still.png --ignore-certificate-errors",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "@remotion/google-fonts": "4.0.524",
    "@remotion/motion-blur": "4.0.524",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.524"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.6.3"
  }
}
