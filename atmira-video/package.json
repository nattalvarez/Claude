{
  "name": "atmira-corporativo",
  "version": "1.0.0",
  "private": true,
  "description": "atmira \u2014 v\u00eddeo corporativo redise\u00f1ado (Remotion + locuci\u00f3n ElevenLabs es-ES)",
  "scripts": {
    "start": "remotion studio",
    "assets": "python3 scripts/extract_assets.py",
    "voice": "node scripts/generate_voice.mjs",
    "audio": "node scripts/build_audio.mjs && node scripts/build_timeline.mjs && python3 scripts/synth_music.py",
    "frames": "node scripts/frames.mjs",
    "render": "remotion render src/index.ts AtmiraCorporativo out/atmira-corporativo-v9.mp4 --codec=h264 --crf=17 --concurrency=4",
    "preview": "remotion render src/index.ts AtmiraCorporativo out/preview.mp4 --scale=0.5 --crf=30 --concurrency=4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.5",
    "@remotion/cli": "4.0.524",
    "@remotion/media-utils": "4.0.524",
    "@remotion/transitions": "4.0.524",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.524"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.6.3"
  }
}